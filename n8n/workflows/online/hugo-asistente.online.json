      "id": "a45a0f8a-1e7a-42de-8421-adab7cb2b926",
      "name": "Responder a Hugo"
    },
    {
      "parameters": {
        "jsCode": "const content =\n  $json.choices?.[0]?.message?.content ||\n  \"\";\n\nlet parsed;\n\ntry {\n  parsed = JSON.parse(content);\n} catch {\n  parsed = { reply: content };\n}\n\nreturn [\n  {\n    json: {\n      reply: parsed.reply || \"Hugo no pudo generar una respuesta clara.\",\n      source: \"groq\"\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        528,
        0
      ],
      "id": "af894bfb-ce44-42af-ae96-6d83144cbb81",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{$env.GROQ_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n  {\n    model: \"llama-3.1-8b-instant\",\n    temperature: 0.2,\n    max_completion_tokens: 350,\n    messages: [\n      {\n        role: \"system\",\n        content: \"Sos Hugo, asistente academico de Study Planner (Agenda académica). Responde en español latinoamericano argentino, breve, claro, respetuoso y accionable. Usa solamente las tareas recibidas. Si haces una prediccion, explicala como una estimacion basada en fecha limite, dificultad, estado y subtareas. No inventes materias, fechas ni datos. Maximo 4 oraciones. Devolve solamente JSON valido con esta forma: {\\\"reply\\\":\\\"tu respuesta\\\"}\"\n      },\n      {\n        role: \"user\",\n        content:\n`Pregunta del usuario:\n${$json.body.message}\n\nTareas actuales:\n${JSON.stringify($json.body.tasks)}\n\nFecha actual:\n${$now}`\n      }\n    ]\n  }\n}}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
